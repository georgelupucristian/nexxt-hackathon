# Copy to supabase/functions/.env (gitignored) for local runs; in the cloud set them with
# `supabase secrets set --env-file supabase/functions/.env`.
STRIPE_SECRET_KEY=sk_test_...
# local: from `stripe listen --print-secret`; cloud: the signing secret of the dashboard endpoint
STRIPE_WEBHOOK_SECRET=whsec_...
APP_URL=http://localhost:5173
# true = every new student gets a Stripe test clock (sandbox demo)
DEMO_MODE=true
